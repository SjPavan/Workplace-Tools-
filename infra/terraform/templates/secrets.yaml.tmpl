# Secrets Configuration
# Generated by Terraform - DO NOT EDIT MANUALLY
# Environment: ${ENVIRONMENT}

secrets:
  # Database Secrets
  database:
    url: "${DATABASE_URL}"
    password: "${DB_PASSWORD}"
    host: "${PROJECT_ID}.supabase.co"
    port: 5432
    name: "postgres"
    user: "postgres"
  
  # Supabase Secrets
  supabase:
    project_id: "${PROJECT_ID}"
    service_role_key: "${SUPABASE_SERVICE_ROLE_KEY}"
    anon_key: "${SUPABASE_ANON_KEY}"
    api_url: "https://${PROJECT_ID}.supabase.co"
  
  # Authentication Secrets
  auth:
    jwt_secret: "your_jwt_secret_here_change_in_production"
    session_secret: "your_session_secret_here_change_in_production"
    encryption_key: "your_encryption_key_here_32_chars_long"
    refresh_token_secret: "your_refresh_token_secret_here"
  
  # API Keys (add your actual API keys here)
  apis:
    openai_api_key: "your_openai_api_key_here"
    anthropic_api_key: "your_anthropic_api_key_here"
    google_api_key: "your_google_api_key_here"
    stripe_secret_key: "your_stripe_secret_key_here"
    stripe_publishable_key: "your_stripe_publishable_key_here"
  
  # Third-party Service Credentials
  services:
    redis:
      url: "your_redis_connection_string_here"
      password: "your_redis_password_here"
    
    aws:
      access_key_id: "your_aws_access_key_here"
      secret_access_key: "your_aws_secret_key_here"
      region: "us-east-1"
      s3_bucket: "your_s3_bucket_name_here"
    
    sendgrid:
      api_key: "your_sendgrid_api_key_here"
      from_email: "noreply@yourdomain.com"
    
    twilio:
      account_sid: "your_twilio_account_sid_here"
      auth_token: "your_twilio_auth_token_here"
      phone_number: "+1234567890"
  
  # OAuth Provider Secrets
  oauth:
    google:
      client_id: "your_google_oauth_client_id_here"
      client_secret: "your_google_oauth_client_secret_here"
    
    github:
      client_id: "your_github_oauth_client_id_here"
      client_secret: "your_github_oauth_client_secret_here"
    
    twitter:
      api_key: "your_twitter_api_key_here"
      api_secret: "your_twitter_api_secret_here"
  
  # Monitoring and Logging
  monitoring:
    sentry_dsn: "your_sentry_dsn_here"
    datadog_api_key: "your_datadog_api_key_here"
    loggly_token: "your_loggly_token_here"
  
  # Deployment Secrets
  deployment:
    render_api_key: "your_render_api_key_here"
    railway_token: "your_railway_token_here"
    vercel_token: "your_vercel_token_here"
    eas_token: "your_eas_token_here"
    
    # App Store Credentials
    apple:
      team_id: "your_apple_team_id_here"
      key_id: "your_apple_key_id_here"
      issuer_id: "your_apple_issuer_id_here"
    
    google_play:
      service_account_json: "path/to/your/google-play-service-account.json"
  
  # Security
  security:
    webhook_secret: "your_webhook_secret_here"
    api_secret: "your_api_secret_here"
    backup_encryption_key: "your_backup_encryption_key_here"

# Environment-specific overrides
environment_overrides:
  dev:
    log_level: "debug"
    enable_debug: true
    ssl_verify: false
  
  staging:
    log_level: "info"
    enable_debug: false
    ssl_verify: true
  
  prod:
    log_level: "error"
    enable_debug: false
    ssl_verify: true
    enable_monitoring: true

# Rotation Schedule (in days)
rotation_schedule:
  database_password: 90
  api_keys: 180
  jwt_secret: 365
  encryption_key: 730
