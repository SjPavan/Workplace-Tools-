# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# General Configuration
NODE_ENV=development
ENVIRONMENT=dev
PROJECT_ID=your_project_id

# Supabase Configuration
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_API_URL=your_supabase_api_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@your-project.supabase.co:5432/postgres

# Backend Configuration (Render)
RENDER_API_KEY=your_render_api_key
BACKEND_RENDER_SERVICE_ID=your_backend_service_id
BACKEND_URL=https://api-dev.yourdomain.com
BACKEND_PORT=8000

# Worker Configuration (Railway)
RAILWAY_TOKEN=your_railway_token
WORKER_RAILWAY_SERVICE_ID=your_worker_service_id
WORKER_URL=https://worker-dev.up.railway.app
WORKER_MODE=true

# Web Configuration (Vercel)
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
WEB_URL=https://dev.yourdomain.com

# Mobile Configuration (EAS)
EAS_PROJECT_ID=your_eas_project_id
EAS_TOKEN=your_eas_token

# API Keys (add your actual API keys here)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key

# Third-party Services
REDIS_URL=redis://user:password@host:port
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Monitoring and Logging
LOG_LEVEL=debug
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_api_key

# Authentication
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
SESSION_SECRET=your_session_secret_here_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_here_32_chars_long

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=200

# Feature Flags
ENABLE_REALTIME=true
ENABLE_VECTOR=false
ENABLE_CRON_JOBS=true
ENABLE_ANALYTICS=false

# Development Only
DEBUG=true
HOT_RELOAD=true
SSL_VERIFY=false

# OAuth Provider Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# App Store Credentials (for mobile deployment)
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_ISSUER_ID=your_apple_issuer_id

# Google Play Credentials
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=path/to/your/service-account.json

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Storage
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_REGION=us-east-1

# Webhooks
WEBHOOK_SECRET=your_webhook_secret_here

# Backup and Recovery
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here
BACKUP_RETENTION_DAYS=30

# Security
CORS_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Cache
CACHE_TTL=3600
CACHE_PREFIX=workplace_tools

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt

# Task Processing
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT=300
TASK_RETRY_ATTEMPTS=3

# Notification Settings
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_RETRY_ATTEMPTS=3
PUSH_NOTIFICATION_ENABLED=false

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_SAMPLE_RATE=0.1

# Logging
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/workplace-tools.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7
