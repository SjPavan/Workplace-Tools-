# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for admin operations)
# Get this from your Supabase project settings under API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key
# Get this from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Brave Search API Key (optional - for web search functionality)
# Get this from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here

# Optional API configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
