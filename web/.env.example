# ==========================================
# Supabase Configuration
# ==========================================
# Get these values from your Supabase project settings at https://app.supabase.com
# Create a free account at https://supabase.com/signup
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# AI Service Configuration
# ==========================================

# Google Gemini API Key
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier includes 60 requests per minute
GEMINI_API_KEY=your-gemini-api-key-here

# Brave Search API Key
# Get your free API key from: https://brave.com/search/api/
# Free tier includes 2,000 searches per month
BRAVE_API_KEY=your-brave-search-api-key-here

# ==========================================
# Application Configuration
# ==========================================

# Optional: External API URL for AI assistant backend
# If not set, defaults to local development server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# Feature Flags (Optional)
# ==========================================

# Enable/disable AI chat features
NEXT_PUBLIC_ENABLE_AI_CHAT=true

# Enable/disable data export functionality
NEXT_PUBLIC_ENABLE_DATA_EXPORT=true

# Enable/disable citation tracking
NEXT_PUBLIC_ENABLE_CITATIONS=true

# Enable/disable Brave Search integration
NEXT_PUBLIC_ENABLE_BRAVE_SEARCH=true

# ==========================================
# Development Configuration
# ==========================================

# Development environment flag
NODE_ENV=development

# Log level (error, warn, info, debug)
LOG_LEVEL=info
