# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration (Optional)
# If not set, the app will use localStorage only
# Set these in browser localStorage instead:
# localStorage.setItem('SUPABASE_URL', 'your-url')
# localStorage.setItem('SUPABASE_ANON_KEY', 'your-key')

# Feature Flags
ENABLE_ATTACHMENTS=false

# AI Orchestration Backend (for production)
AI_ORCHESTRATION_URL=http://localhost:4000
